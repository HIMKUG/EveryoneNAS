# EveryoneNAS Runtime & Build Environment Variables Example
# Copy to `.env` or export in your shell before launching services.

# Server listening port (default: 7842)
LANVAULT_PORT=7842

# Vault storage root directory
LANVAULT_VAULT_ROOT=D:\EveryoneNAS

# Client local state database directory (default: %LOCALAPPDATA%\EveryoneNAS)
LANVAULT_DATA_DIR=

# Web management console password (min 8 chars; Android JNI auto-generates a 24-char random password if unset)
LANVAULT_WEB_PASSWORD=

# Parallel build jobs for 8C16T host
CARGO_BUILD_JOBS=16
CMAKE_BUILD_PARALLEL_LEVEL=16
